APP_ENV=production
PORT=8080
LOG_LEVEL=info
LOG_FORMAT=json

DATABASE_URL=postgres://kindred:CHANGEME@YOUR-RDS-ENDPOINT:5432/dating_platform?sslmode=require
DB_MAX_CONNS=10
DB_MIN_CONNS=0

JWT_SECRET=CHANGEME-64-hex-chars
JWT_ISSUER=kindred

REDIS_URL=redis://redis:6379/0

# Set to the deployed frontend origin. Must not be empty or * when
# APP_ENV=production; the server refuses to start otherwise.
CORS_ALLOWED_ORIGINS=https://YOUR-BACKEND-HOST
WS_ALLOWED_ORIGINS=https://YOUR-BACKEND-HOST
APP_BASE_URL=https://YOUR-BACKEND-HOST

S3_ENDPOINT=https://s3.YOUR-REGION.amazonaws.com
S3_PUBLIC_BASE_URL=https://s3.YOUR-REGION.amazonaws.com
S3_REGION=YOUR-REGION
S3_BUCKET=kindred-media-YOUR-ACCOUNT-ID
S3_ACCESS_KEY=CHANGEME
S3_SECRET_KEY=CHANGEME
S3_PATH_STYLE=true

EMAIL_MODE=log
EMAIL_FROM=no-reply@kindred.local

METRICS_ENABLED=true
RATE_LIMIT_ENABLED=true
MATCH_GATE_ENABLED=true
