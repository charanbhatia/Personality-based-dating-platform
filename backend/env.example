# --- Core ---
ENV=development
PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/dating_platform?sslmode=disable
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# --- Postgres pool ---
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME_MINUTES=60
DB_MAX_CONN_IDLE_MINUTES=5

# --- Redis (optional: leave empty to run without rate limiting) ---
REDIS_URL=redis://localhost:6379/0

# --- HTTP ---
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate limiting (requests per window, per IP) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL=600
RATE_LIMIT_AUTH=20

# --- Messaging ---
# Conversations require a mutual match. Disable only for local work before the
# matches table exists.
MATCH_GATE_ENABLED=true
MAX_MESSAGE_LENGTH=4000
RATE_LIMIT_MESSAGE_SEND=5
RATE_LIMIT_MESSAGE_WINDOW_SECONDS=1

# --- Queue and worker (Redis Streams) ---
QUEUE_MAX_LEN=10000
QUEUE_MAX_ATTEMPTS=5
QUEUE_RETRY_DELAY_SECONDS=30
QUEUE_BLOCK_SECONDS=5
WORKER_CONCURRENCY=4
# Defaults to the hostname; must be unique per worker replica.
WORKER_NAME=
