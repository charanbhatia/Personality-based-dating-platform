# Backend configuration. Copy to .env and adjust; every value below is the
# default that internal/config applies when the variable is unset, so an empty
# environment boots a working development server.
#
# Anything marked "production" is additionally validated when APP_ENV is
# production, prod or staging, and the process refuses to start if it is unsafe.

# --- Core -------------------------------------------------------------------

# development | production | prod | staging
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dating_platform?sslmode=disable

# Apply pending migrations at boot. Set to false where a deployment runs
# `go run ./cmd/migrate` as a separate release step.
AUTO_MIGRATE=true

# --- Auth -------------------------------------------------------------------

# This exact value is the development placeholder and is REJECTED in production,
# where the secret must also be at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=dev-secret-change-in-production
# Signed into the `iss` claim and required to match on verification, so tokens
# from another deployment are refused.
JWT_ISSUER=dating-platform

# Access tokens are short-lived because they cannot be revoked; the refresh
# token is the revocable credential and must outlive them.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
PASSWORD_RESET_TTL=1h

# --- Personality ------------------------------------------------------------

# How long a user must wait before retaking the assessment. Set to 0 to allow
# unlimited retakes, which is useful when demoing.
ASSESSMENT_RETAKE_INTERVAL=720h

# --- Discovery --------------------------------------------------------------

DISCOVER_DEFAULT_LIMIT=20
DISCOVER_MAX_LIMIT=50
# Trait vectors are cached per user; a short TTL bounds how long a retake can be
# scored against stale answers if an invalidation is ever missed.
TRAIT_CACHE_TTL=1m

# --- Outbox -----------------------------------------------------------------

# Domain events are written in the same transaction as the state change and
# published by a background drainer. Person C replaces the publisher with Redis
# Streams; these knobs apply either way.
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL=2s
# Attempts before an event is left for inspection rather than retried forever.
OUTBOX_MAX_ATTEMPTS=10

# --- Server -----------------------------------------------------------------

# Comma-separated. Required in production; when empty the request origin is
# reflected, which is convenient locally and unsafe once deployed.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
READ_HEADER_TIMEOUT=10s
SHUTDOWN_TIMEOUT=15s
# 0 lets pgx choose (4, or GOMAXPROCS when higher).
DB_MAX_CONNS=0

# --- Logging ----------------------------------------------------------------

# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=text

# --- Tests ------------------------------------------------------------------

# Integration tests are skipped unless this is set, and they TRUNCATE the tables
# they touch, so it must point at a throwaway database:
#   go test ./internal/integration/...
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/dating_test?sslmode=disable
