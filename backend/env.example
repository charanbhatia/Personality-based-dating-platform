# --- Core ---
ENV=development
PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/dating_platform?sslmode=disable
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# --- Postgres pool ---
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME_MINUTES=60
DB_MAX_CONN_IDLE_MINUTES=5

# --- Redis (optional: leave empty to run without rate limiting) ---
REDIS_URL=redis://localhost:6379/0

# --- HTTP ---
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate limiting (requests per window, per IP) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL=600
RATE_LIMIT_AUTH=20

# --- Messaging ---
# Conversations require a mutual match. Disable only for local work before the
# matches table exists.
MATCH_GATE_ENABLED=true
MAX_MESSAGE_LENGTH=4000
RATE_LIMIT_MESSAGE_SEND=5
RATE_LIMIT_MESSAGE_WINDOW_SECONDS=1

# --- Queue and worker (Redis Streams) ---
QUEUE_MAX_LEN=10000
QUEUE_MAX_ATTEMPTS=5
QUEUE_RETRY_DELAY_SECONDS=30
QUEUE_BLOCK_SECONDS=5
WORKER_CONCURRENCY=4
# Defaults to the hostname; must be unique per worker replica.
WORKER_NAME=

# --- Object storage (optional: leave S3_ENDPOINT empty to disable media) ---
# S3_ENDPOINT is reached by the server; S3_PUBLIC_BASE_URL is reached by browsers.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dating-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=900

# --- Media ---
MEDIA_MAX_BYTES=10485760
# WebP is accepted but cannot be resized by the standard library, so those
# uploads reuse the original as their thumbnail.
MEDIA_ALLOWED_TYPES=image/jpeg,image/png,image/webp
MEDIA_DAILY_UPLOAD_LIMIT=50
THUMBNAIL_MAX_EDGE=512
