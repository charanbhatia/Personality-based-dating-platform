# Backend configuration. Copy to .env and adjust.
#
# An empty environment still boots a development API (Postgres required).
# Redis, MinIO and SMTP are optional: leave them unset to run B's domains alone.
#
# Anything marked "production" is rejected when APP_ENV is production, prod or staging.

# --- Core -------------------------------------------------------------------

# development | production | prod | staging
# Person C's compose stack used ENV; both names are accepted (APP_ENV wins).
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dating_platform?sslmode=disable
AUTO_MIGRATE=true

# --- Auth -------------------------------------------------------------------

# This exact value is REJECTED in production. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=dev-secret-change-in-production
JWT_ISSUER=dating-platform
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
PASSWORD_RESET_TTL=1h
EMAIL_VERIFICATION_TTL=24h

# --- Personality / discovery ------------------------------------------------

ASSESSMENT_RETAKE_INTERVAL=720h
DISCOVER_DEFAULT_LIMIT=20
DISCOVER_MAX_LIMIT=50
TRAIT_CACHE_TTL=1m

# --- Outbox -----------------------------------------------------------------

OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL=2s
OUTBOX_MAX_ATTEMPTS=10

# --- Server -----------------------------------------------------------------

# Comma-separated. Required in production. CORS_ORIGINS is accepted as an alias.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
READ_HEADER_TIMEOUT=10s
SHUTDOWN_TIMEOUT=15s
DB_MAX_CONNS=0
DB_MIN_CONNS=0

# --- Logging ----------------------------------------------------------------

LOG_LEVEL=info
LOG_FORMAT=text

# --- Redis (Person C; optional) ---------------------------------------------
# Leave empty to disable rate limiting, queues and cross-replica websocket fanout.
REDIS_URL=

# --- Rate limiting (no-op without REDIS_URL) --------------------------------

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL=600
RATE_LIMIT_AUTH=20

# --- Messaging --------------------------------------------------------------

MATCH_GATE_ENABLED=true
MAX_MESSAGE_LENGTH=4000
RATE_LIMIT_MESSAGE_SEND=5
RATE_LIMIT_MESSAGE_WINDOW_SECONDS=1

# --- Queue / worker ---------------------------------------------------------

QUEUE_MAX_LEN=10000
QUEUE_MAX_ATTEMPTS=5
QUEUE_RETRY_DELAY_SECONDS=30
QUEUE_BLOCK_SECONDS=5
WORKER_CONCURRENCY=4
WORKER_NAME=
WORKER_METRICS_PORT=9091

# --- Object storage (optional; empty S3_ENDPOINT disables media) -------------

S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
S3_REGION=us-east-1
S3_BUCKET=dating-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=900

# --- Media ------------------------------------------------------------------

MEDIA_MAX_BYTES=10485760
MEDIA_ALLOWED_TYPES=image/jpeg,image/png,image/webp
MEDIA_DAILY_UPLOAD_LIMIT=50
THUMBNAIL_MAX_EDGE=512

# --- Realtime (GET /ws) -----------------------------------------------------

WS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
WS_MAX_MESSAGE_BYTES=16384
WS_PING_INTERVAL_SECONDS=30
WS_PONG_TIMEOUT_SECONDS=70
WS_WRITE_TIMEOUT_SECONDS=10

# --- Observability ----------------------------------------------------------

METRICS_ENABLED=true
METRICS_SAMPLE_INTERVAL_SECONDS=15

# --- Notifications / email --------------------------------------------------

APP_BASE_URL=http://localhost:5173
EMAIL_MODE=log
EMAIL_FROM=no-reply@kindred.local
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Push (FCM / APNs; optional) --------------------------------------------
# Leave empty to store device tokens and log "would push". Set keys to deliver.
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
APNS_BUNDLE_ID=
APNS_PRODUCTION=false

# --- Tests ------------------------------------------------------------------

# Integration tests TRUNCATE tables. Point this at a throwaway database:
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/dating_test?sslmode=disable
